#: orologic_modules/finestra_scacchiera.py:252
#: orologic_modules/finestra_scacchiera.py:275
msgid ""
"l: l'ultima mossa; L: le ultime due; u: alla casa d'arrivo dell'ultima "
"mossa."
msgstr ""
"l: la última jugada; L: las dos últimas; u: a la casilla de llegada de la "
"última jugada."

#: orologic_modules/finestra_scacchiera.py:253
#: orologic_modules/finestra_scacchiera.py:276
msgid "m: le mosse possibili del pezzo sollevato, o di quello sulla casa."
msgstr ""
"m: las jugadas posibles de la pieza levantada, o de la que está en la "
"casilla."

#: orologic_modules/finestra_scacchiera.py:254
