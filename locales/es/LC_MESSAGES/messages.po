msgid "Backspace: il menu dei comandi dell'esploratore."
msgstr "Retroceso: el menú de comandos del explorador."

#: orologic_modules/finestra_scacchiera.py:228
#: orologic_modules/finestra_scacchiera.py:236
#: orologic_modules/finestra_scacchiera.py:257
msgid "?: questo aiuto. Esc chiude la scacchiera."
msgstr "?: esta ayuda. Esc cierra el tablero."

#: orologic_modules/finestra_scacchiera.py:233
msgid ""
"Invio: posa il pezzo sollevato, se la mossa vale, e la mossa entra nella "
"partita."
msgstr ""
"Intro: deja la pieza levantada, si la jugada es válida, y la jugada entra en"
" la partida."

#: orologic_modules/finestra_scacchiera.py:234
#: orologic_modules/finestra_scacchiera.py:255
msgid "C: un commento alla mossa."
msgstr "C: un comentario a la jugada."

#: orologic_modules/finestra_scacchiera.py:235
msgid "Backspace: il menu dei comandi di Easyfish."
msgstr "Retroceso: el menú de comandos de Easyfish."

#: orologic_modules/finestra_scacchiera.py:241
#: orologic_modules/finestra_scacchiera.py:266
