#: orologic_modules/finestra_scacchiera.py:221
msgid ""
"Invio: posa il pezzo sollevato, e la mossa entra nella partita o nella "
"variante."
msgstr ""
"Intro: deja la pieza levantada, y la jugada entra en la partida o en la "
"variante."

#: orologic_modules/finestra_scacchiera.py:222
msgid ""
"Alt con a e d: la mossa precedente e la successiva; Alt con q ed e: la prima"
" e l'ultima."
msgstr ""
"Alt con a y d: la jugada anterior y la siguiente; Alt con q y e: la primera "
"y la última."

#: orologic_modules/finestra_scacchiera.py:223
msgid ""
"Alt con w e x: la variante sopra e quella sotto; Alt con z: fuori dalla "
"variante."
msgstr ""
"Alt con w y x: la variante de arriba y la de abajo; Alt con z: fuera de la "
"variante."

#: orologic_modules/finestra_scacchiera.py:224
msgid ""
"Alt con s: l'analisi; Alt con r: i suoi secondi; Alt con t: le sue linee."
msgstr ""
"Alt con s: el análisis; Alt con r: sus segundos; Alt con t: sus líneas."

#: orologic_modules/finestra_scacchiera.py:225
msgid "Alt con c: il commento della mossa; C: scrivere il commento."
msgstr "Alt con c: el comentario de la jugada; C: escribir el comentario."

#: orologic_modules/finestra_scacchiera.py:226
msgid "Alt con u: taglia la mossa; Alt con b: la scacchiera a caratteri."
msgstr "Alt con u: corta la jugada; Alt con b: el tablero en caracteres."

