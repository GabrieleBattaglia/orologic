msgid "numero della mossa da giocare"
msgstr "numéro du coup à jouer"

#: orologic_modules/modello_prompt.py:77
msgid "ultima mossa giocata"
msgstr "dernier coup joué"

#: orologic_modules/modello_prompt.py:78
msgid "bilancio del materiale, positivo se il Bianco ne ha di piu'"
msgstr "bilan du matériel, positif si les Blancs en ont plus"

#: orologic_modules/modello_prompt.py:79
msgid "a chi tocca, B o N"
msgstr "à qui le trait, B ou N"

#: orologic_modules/modello_prompt.py:80
msgid "mosse senza catture ne' mosse di pedone, verso le 50"
msgstr "coups sans prise ni coup de pion, vers la règle des 50 coups"

#: orologic_modules/modello_prompt.py:81
msgid "mosse che mancano al prossimo controllo del tempo"
msgstr "coups restants avant le prochain contrôle du temps"

#: orologic_modules/modello_prompt.py:82
msgid "la posizione in FEN"
msgstr "la position en FEN"

#: orologic_modules/modello_prompt.py:83
msgid "la scacchiera in caratteri, su piu' righe, come quella di .s"
msgstr "l'échiquier en caractères, sur plusieurs lignes, comme celui de .s"

#: orologic_modules/modello_prompt.py:84
msgid "durata della partita"
msgstr "durée de la partie"

#: orologic_modules/modello_prompt.py:85
msgid "nome dell'avversario"
msgstr "nom de l'adversaire"

#: orologic_modules/modello_prompt.py:86
msgid "stati: pausa, senza orologio, premossa, RECLAMA"
msgstr "états : pause, sans horloge, premove, RÉCLAMER"

#: orologic_modules/modello_prompt.py:144
msgid ""
"Prompt di gioco di Orologic. Le righe che cominciano con il dollaro sono "
"spiegazioni, e Orologic le ignora."
msgstr ""
"Invite de jeu d'Orologic. Les lignes qui commencent par le signe dollar sont"
" des explications, et Orologic les ignore."

#: orologic_modules/modello_prompt.py:145
msgid ""
"Scrivi il modello nell'ultima riga, quella senza dollaro, poi salva e chiudi"
" il Blocco note."
msgstr ""
"Écrivez le modèle sur la dernière ligne, celle sans dollar, puis enregistrez"
" et fermez le Bloc-notes."

#: orologic_modules/modello_prompt.py:146
msgid ""
"Ogni codice e' il percento seguito da una lettera, maiuscola o minuscola; il"
" resto e' testo libero."
msgstr ""
"Chaque code est le signe pourcentage suivi d'une lettre, majuscule ou "
"minuscule ; le reste est du texte libre."

#: orologic_modules/modello_prompt.py:150
#, python-format
msgid ""
"Con una v dopo la lettera, la forma estesa, a parole: %bv %nv %iv %av %dv "
"%gv %tv %uv %vv."
msgstr ""
"Avec un v après la lettre, la forme longue, en toutes lettres : %bv %nv %iv "
"%av %dv %gv %tv %uv %vv."

#: orologic_modules/modello_prompt.py:151
msgid ""
"%bp e %np: la percentuale di tempo consumato dal Bianco e dal Nero, come .1 "
"e .2: in arbitraggio, in Tempo e contro il motore col tempo a partita."
msgstr ""
"%bp et %np : le pourcentage de temps consommé par les Blancs et par les "
"Noirs, comme .1 et .2 : en arbitrage, dans Tempo et contre le moteur avec un"
" temps par partie."

#: orologic_modules/modello_prompt.py:152
msgid ""
"Un numero dopo il percento, da 1 a 120, rende il prompt dinamico: %4 lo "
"riscrive ogni 4 secondi. Senza numero il prompt e' statico, e i tempi non "
"compaiono."
msgstr ""
"Un nombre après le signe pourcentage, de 1 à 120, rend l'invite dynamique : "
"%4 la réécrit toutes les 4 secondes. Sans nombre l'invite est statique, et "
"les temps n'apparaissent pas."

#: orologic_modules/modello_prompt.py:153
msgid ""
"Se dopo %m c'e' altro, il cursore resta dopo la mossa, e il resto del prompt"
" ti scorre a destra mentre scrivi."
msgstr ""
"S'il y a autre chose après %m, le curseur reste après le coup, et le reste "
"de l'invite glisse vers la droite pendant que vous écrivez."

#: orologic_modules/modello_prompt.py:154
#, python-format
msgid ""
"%c va messo prima di %m: la scacchiera si stampa sopra la riga dove scrivi."
msgstr ""
"%c se met avant %m : l'échiquier s'affiche au-dessus de la ligne où vous "
"écrivez."

#: orologic_modules/modello_prompt.py:155
#, python-format
msgid "%% scrive un percento vero."
msgstr "%% écrit un vrai signe pourcentage."

