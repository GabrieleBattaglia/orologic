msgid "il tempo dell'avversario, dove hai un colore"
msgstr "le temps de l'adversaire, quand vous avez une couleur"

#: orologic_modules/modello_prompt.py:73
msgid "differenza fra gli orologi, positiva se il Bianco ha piu' tempo"
msgstr "écart entre les horloges, positif si les Blancs ont plus de temps"

#: orologic_modules/modello_prompt.py:74
msgid "chi ha piu' tempo: < il Bianco, > il Nero, = pari"
msgstr "qui a le plus de temps : < les Blancs, > les Noirs, = égalité"

