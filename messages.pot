"a ogni mossa fatta si aggiungono i secondi dell'incremento; la prima "
"mossa non ne ha. E' il modo di sempre di Orologic"
msgstr ""

#: orologic_modules/controlli.py:88
msgid "Incremento prima della mossa, Fischer"
msgstr ""

#: orologic_modules/controlli.py:89
msgid ""
"l'incremento c'e' gia' alla partenza, e a ogni mossa fatta arriva quello "
"per la mossa dopo, come nei DGT e nelle regole FIDE"
msgstr ""

#: orologic_modules/controlli.py:91
msgid "Ritardo Bronstein"
msgstr ""

#: orologic_modules/controlli.py:92
msgid ""
"a ogni mossa fatta torna il tempo usato, fino ai secondi del ritardo, "
"senza superare quello d'inizio turno; il ritardo c'e' gia' alla partenza"
msgstr ""

#: orologic_modules/controlli.py:94
msgid "Ritardo semplice, US delay"
msgstr ""

#: orologic_modules/controlli.py:95
msgid ""
"a ogni turno il tempo resta fermo per i secondi del ritardo, poi scende; "
"il ritardo non usato si perde"
msgstr ""

#: orologic_modules/controlli.py:97
msgid "Clessidra"
msgstr ""

#: orologic_modules/controlli.py:98
msgid ""
"il tempo che usi passa all'avversario: la somma dei due orologi resta la "
"stessa"
msgstr ""

#: orologic_modules/controlli.py:100
msgid "Byo-yomi giapponese"
msgstr ""

#: orologic_modules/controlli.py:101
msgid ""
"finito il tempo, ci sono i periodi: una mossa dentro un periodo lo fa "
"ripartire intero, superarlo lo consuma; finiti i periodi cade la "
"bandierina. Solo nell'ultima fase"
msgstr ""

#: orologic_modules/controlli.py:103
msgid "Byo-yomi canadese"
msgstr ""

#: orologic_modules/controlli.py:104
msgid ""
"finito il tempo, le mosse del periodo vanno fatte nei minuti del periodo,"
" contando quella in corso; fatte tutte, il periodo riparte. Solo "
"nell'ultima fase"
msgstr ""

#: orologic_modules/controlli.py:106
msgid "Conta in su"
msgstr ""

#: orologic_modules/controlli.py:107
msgid ""
"finito il tempo, la bandierina non cade: l'orologio conta in su il tempo "
"in piu', come nello Scrabble. Solo nell'ultima fase"
msgstr ""

